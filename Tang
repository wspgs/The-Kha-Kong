---Disable collision on every part of the character.
function TangHub.updateNoclip()
	if not TangHub.noclip then
		return
	end

	local character = localPlayer.Character
	if not character then
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			TangHub.noclipParts[part] = true
			part.CanCollide = false
		end
	end
end

---Restore collision on the parts noclip changed.
function TangHub.restoreNoclip()
	for part in pairs(TangHub.noclipParts) do
		if part.Parent then
			part.CanCollide = true
		end
		TangHub.noclipParts[part] = nil
	end
end

---Load the game's QuestData module so quests, items and rooms are read exactly as the HUD does.
function TangHub.loadQuestData()
	TangHub.lastDataLoad = os.clock()

	local module = replicatedStorage:FindFirstChild("QuestData")
	if not module then
		return
	end

	local success, data = pcall(require, module)
	if not success and setthreadidentity then
		pcall(function()
			setthreadidentity(2)
			data = require(module)
			setthreadidentity(8)
			success = true
		end)
	end

	if success and typeof(data) == "table" then
		TangHub.questData = data
	end
end

---Key colors used by the current game build.
---@return table
function TangHub.getKeyColors()
	local data = TangHub.questData
	if data and typeof(data.KEY_COLORS) == "table" then
		return data.KEY_COLORS
	end

	return DEFAULT_KEY_COLORS
end

---Count the keys the local player holds.
---@return number
function TangHub.countKeys()
	local count = 0

	for _, color in ipairs(TangHub.getKeyColors()) do
		if hasKey(color) then
			count = count + 1
		end
	end

	return count
end

