---Find a part to attach ESP to.
---@param model Model
---@return BasePart?
local function findRoot(model)
	return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart", true)
end

---Get the world position of a prompt.
---@param prompt ProximityPrompt
---@return Vector3?
local function getPromptPosition(prompt)
	local parent = prompt.Parent
	if not parent then
		return nil
	end

	if parent:IsA("Attachment") then
		return parent.WorldPosition
	end

	if parent:IsA("BasePart") then
		return parent.Position
	end

	local root = parent:IsA("Model") and findRoot(parent) or parent:FindFirstChildWhichIsA("BasePart", true)
	return root and root.Position or nil
end

---Lowercase names of the first few ancestors of an instance, joined with spaces.
---@param instance Instance
---@return string
local function getAncestorNames(instance)
	local names = {}
	local current = instance.Parent

	for _ = 1, 4 do
		if not current or current == workspace then
			break
		end

		table.insert(names, string.lower(current.Name))
		current = current.Parent
	end

	return table.concat(names, " ")
end

---Check whether the local player holds a key of the given color.
---@param color string
---@return boolean
local function hasKey(color)
	return localPlayer:GetAttribute("Has" .. tostring(color) .. "Key") == true
end

---Check whether a prompt belongs to a lock or padlock.
---@param prompt ProximityPrompt
---@return boolean
local function isLockPrompt(prompt)
	if string.find(string.lower(prompt.Name), "lock", 1, true) then
		return true
	end

	local names = getAncestorNames(prompt)
	return string.find(names, "padlock", 1, true) ~= nil or string.find(names, "heavylock", 1, true) ~= nil
end

---Check whether a prompt belongs to the generator room.
---@param prompt ProximityPrompt
---@return boolean
local function isGeneratorPrompt(prompt)
	return string.find(prompt:GetFullName(), "GeneratorRoom", 1, true) ~= nil
end

---Check whether a prompt or one of its ancestors is named after a wanted item.
---@param prompt ProximityPrompt
---@param items table
---@return boolean
local function matchesItem(prompt, items)
	for item in pairs(items) do
		local lowerItem = string.lower(item)
		if string.find(string.lower(prompt.ObjectText), lowerItem, 1, true)
			or string.find(string.lower(prompt.ActionText), lowerItem, 1, true)
			or string.find(string.lower(prompt.Name), lowerItem, 1, true) then
			return true
		end
	end

	local current = prompt
	for _ = 1, 4 do
		if not current or current == workspace then
			break
		end

		local name = string.lower(current.Name)
		for item in pairs(items) do
			if string.find(name, string.lower(item), 1, true) then
				return true
			end
		end

		current = current.Parent
	end

	return false
end

---Check whether a prompt is tied to one of the pending quests (by attribute or name).
---@param prompt ProximityPrompt
---@param quests table
---@return boolean
local function matchesQuest(prompt, quests)
	local names = getAncestorNames(prompt)

	for _, quest in ipairs(quests) do
		local id = string.lower(tostring(quest.id))
		if #id > 2 and string.find(names, id, 1, true) then
			return true
		end

		local current = prompt
		for _ = 1, 4 do
			if not current or current == workspace then
				break
			end

			for _, attribute in ipairs({ "QuestId", "Quest", "Id" }) do
				if current:GetAttribute(attribute) == quest.id then
					return true
				end
			end

			current = current.Parent
		end
	end

	return false
end

---Check whether a door prompt belongs to a room.
---@param prompt ProximityPrompt
---@param room string
---@return boolean
local function doorMatchesRoom(prompt, room)
	local model = prompt:FindFirstAncestorWhichIsA("Model")
	if not model then
		return false
	end

	local roomStr = string.lower(tostring(room))
	local modelName = string.lower(model.Name)
	if string.find(modelName, roomStr, 1, true) then
		return true
	end

	local parent = model.Parent
	if parent and parent:IsA("Model") and string.find(string.lower(parent.Name), roomStr, 1, true) then
		return true
	end

	return false
end

---Create a billboard text tag.
---@param adornee BasePart
---@param color Color3
---@return BillboardGui, TextLabel
local function createBillboard(adornee, color)
	local gui = Instance.new("BillboardGui")
	gui.AlwaysOnTop = true
	gui.Size = UDim2.fromOffset(160, 26)
	gui.StudsOffset = Vector3.new(0, 1.5, 0)
	gui.MaxDistance = math.huge
	gui.Adornee = adornee
	gui.Enabled = false
	gui.Parent = espFolder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Parent = gui

	return gui, label
end

---Apply hold / reach modifications to a prompt.
---@param prompt ProximityPrompt
function TangHub.applyPrompt(prompt)
	local cache = TangHub.promptCache[prompt]
	if not cache then
		cache = { hold = prompt.HoldDuration, distance = prompt.MaxActivationDistance }
		TangHub.promptCache[prompt] = cache
	end

	prompt.HoldDuration = TangHub.instantPrompt and 0 or cache.hold
	prompt.MaxActivationDistance = cache.distance * TangHub.reachMultiplier
end

---Re-apply prompt modifications on every known prompt.
function TangHub.applyAllPrompts()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			TangHub.applyPrompt(descendant)
		end
	end
end

---Register an instance for ESP if it matches a category.
---@param instance Instance
function TangHub.register(instance)
	if TangHub.tags[instance] then
		return
	end

	if instance:IsA("ProximityPrompt") then
		TangHub.applyPrompt(instance)

		local category = PROMPT_CATEGORIES[instance.Name]
		if not category then
			-- Unknown prompts (padlocks, gate parts) are still used by auto finish.
			TangHub.otherPrompts[instance] = true
			return
		end

		local adornee = instance.Parent
		if adornee and not adornee:IsA("BasePart") then
			adornee = adornee:IsA("Model") and findRoot(adornee) or adornee:FindFirstChildWhichIsA("BasePart", true)
		end
		if not adornee then
			return
		end

		local text = category.label
		if instance.ObjectText ~= "" then
			text = text .. " (" .. instance.ObjectText .. ")"
		end

		local gui, label = createBillboard(adornee, category.color)
		TangHub.tags[instance] = { gui = gui, label = label, adornee = adornee, key = category.key, text = text, prompt = instance }
		return
	end

	if instance:IsA("Model") and MODEL_CATEGORIES[instance.Name] then
		local category = MODEL_CATEGORIES[instance.Name]
		local adornee = findRoot(instance)
		if not adornee then
			return
		end

		local gui, label = createBillboard(adornee, category.color)
		TangHub.tags[instance] = { gui = gui, label = label, adornee = adornee, key = category.key, text = category.label }
	end
end

---Scan the workspace without freezing the client.
function TangHub.scan()
	local descendants = workspace:GetDescendants()
	for index, descendant in ipairs(descendants) do
		if TangHub.detached then
			return
		end

		TangHub.register(descendant)
		if index % 800 == 0 then
			task.wait()
		end
	end
end

---Create or refresh an ESP entry that follows a character model.
---@param store table
---@param owner any
---@param character Model
---@param labelText string
---@param color Color3
---@return table?
local function updateCharacterEsp(store, owner, character, labelText, color)
	local root = findRoot(character)
	if not root then
		return nil
	end

	local entry = store[owner]
	if not entry then
		local highlight = Instance.new("Highlight")
		highlight.FillTransparency = 0.7
		highlight.OutlineColor = color
		highlight.FillColor = color
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = espFolder

		local gui, label = createBillboard(root, color)
		entry = { highlight = highlight, gui = gui, label = label }
		store[owner] = entry
	end

	entry.highlight.Adornee = character
	entry.gui.Adornee = root
	entry.label.Text = labelText
	entry.root = root
	return entry
end

---Hide an ESP entry without destroying it.
---@param entry table?
local function hideEntry(entry)
	if not entry then
		return
	end

	entry.highlight.Enabled = false
	entry.gui.Enabled = false
end

---Show an ESP entry.
---@param entry table
local function showEntry(entry)
	entry.highlight.Enabled = true
	entry.gui.Enabled = true
end

---Update ghost ESP and proximity alert.
---@param origin Vector3
function TangHub.updateGhost(origin)
	local ghost = workspace:FindFirstChild("Ghost")
	local entry = TangHub.ghostEntry

	if not ghost or not ghost:IsA("Model") then
		hideEntry(entry)
		return
	end

	local root = findRoot(ghost)
	if not root then
		hideEntry(entry)
		return
	end

	local distance = (root.Position - origin).Magnitude

	if TangHub.enabled.ghost then
		local holder = { ghost = TangHub.ghostEntry }
		TangHub.ghostEntry = updateCharacterEsp(holder, "ghost", ghost, string.format("ผี [%dm]", distance), GHOST_COLOR)
		if TangHub.ghostEntry then
			showEntry(TangHub.ghostEntry)
		end
	else
		hideEntry(entry)
	end

	if TangHub.ghostAlert and distance <= TangHub.alertDistance and os.clock() - TangHub.lastAlert > 5 then
		TangHub.lastAlert = os.clock()
		if TangHub.window then
			TangHub.window:notify({ Title = "ระวัง!", Text = string.format("ผีอยู่ห่างแค่ %d เมตร", distance), Duration = 3 })
		end
	end
end

---Update other players ESP.
function TangHub.updatePlayers()
	for _, player in ipairs(playersService:GetPlayers()) do
		if player == localPlayer then
			continue
		end

		local entry = TangHub.playerTags[player]
		local character = player.Character
		if not (TangHub.enabled.players and character) then
			hideEntry(entry)
			continue
		end

		entry = updateCharacterEsp(TangHub.playerTags, player, character, player.DisplayName, PLAYER_COLOR)
		if entry then
			showEntry(entry)
		end
	end
end

---Main per-interval update for all object tags.
---@param origin Vector3
---@param hrp BasePart?
function TangHub.updateTags(origin, hrp)
	for instance, tag in pairs(TangHub.tags) do
		if not instance:IsDescendantOf(workspace) or not tag.adornee:IsDescendantOf(workspace) then
			tag.gui:Destroy()
			TangHub.tags[instance] = nil
			continue
		end

		local distance = (tag.adornee.Position - origin).Magnitude
		local promptAlive = tag.prompt == nil or tag.prompt.Enabled
		local visible = TangHub.enabled[tag.key] and promptAlive and distance <= TangHub.maxDistance

		tag.gui.Enabled = visible == true
		if visible then
			tag.label.Text = string.format("%s [%dm]", tag.text, distance)
		end

		-- Auto pickup nearby items.
		local prompt = tag.prompt
		if TangHub.autoPickup and tag.key == "pickup" and promptAlive and hrp and prompt then
			local pickupDistance = (tag.adornee.Position - hrp.Position).Magnitude
			local lastTime = TangHub.pickupTimes[prompt] or 0
			if pickupDistance <= TangHub.autoPickupRange and os.clock() - lastTime > AUTO_PICKUP_COOLDOWN then
				TangHub.pickupTimes[prompt] = os.clock()
				pcall(fireproximityprompt, prompt)
			end
		end
	end
end

