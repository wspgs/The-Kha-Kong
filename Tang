---Start scanning and the update loop.
function TangHub.start()
	TangHub.lastProgress = os.clock()
	TangHub.loadQuestData()

	task.spawn(TangHub.scan)
	task.spawn(TangHub.autoFinishLoop)

	-- Hook the repair minigame remote.
	task.spawn(function()
		local remotes = replicatedStorage:WaitForChild("HorrorRemotes", 15)
		local questRemote = remotes and remotes:WaitForChild("QuestGame", 15)
		if not questRemote or TangHub.detached then
			return
		end

		TangHub.questRemote = questRemote
		table.insert(TangHub.connections, questRemote.OnClientEvent:Connect(TangHub.onQuestEvent))
	end)

	table.insert(TangHub.connections, workspace.DescendantAdded:Connect(function(descendant)
		-- Wait a frame so parents and properties are ready.
		task.defer(TangHub.register, descendant)
	end))

	table.insert(TangHub.connections, playersService.PlayerRemoving:Connect(function(player)
		local entry = TangHub.playerTags[player]
		if entry then
			entry.highlight:Destroy()
			entry.gui:Destroy()
			TangHub.playerTags[player] = nil
		end
	end))

	-- Noclip must run every physics step.
	table.insert(TangHub.connections, runService.Stepped:Connect(TangHub.updateNoclip))

	-- Re-apply the stamina flag after every respawn.
	table.insert(TangHub.connections, localPlayer.CharacterAdded:Connect(function()
		TangHub.questActive = nil
		TangHub.legacyLockPhase = false
		TangHub.lockTries = 0
		task.defer(TangHub.updateStamina)
	end))

	local elapsed = 0
	table.insert(TangHub.connections, runService.Heartbeat:Connect(function(delta)
		elapsed = elapsed + delta
		if elapsed < UPDATE_INTERVAL then
			return
		end
		elapsed = 0

		TangHub.updateStamina()

		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local origin = camera.CFrame.Position

		TangHub.updateTags(origin, hrp)
		TangHub.updateGhost(origin)
		TangHub.updatePlayers()
		TangHub.updateLighting()
	end))
end

---Download and compile the UI library.
---@return table?
local function loadLibrary()
	local response = request({ Url = UI_URL, Method = "GET" })
	local chunk, compileError = loadstring(response.Body)
	if not chunk then
		warn("compile error: " .. tostring(compileError))
		return nil
	end

	return chunk()
end

---Called when initialization errors.
---@param errorMessage string
local function onInitializeError(errorMessage)
	warn("Tang Hub failed to initialize.")
	warn(errorMessage)
	warn(debug.traceback())
	TangHub.detach()
end

---Entry point.
local function initializeScript()
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	local Library = loadLibrary()
	if not Library then
		return TangHub.detach()
	end

	TangHub.buildMenu(Library)
	TangHub.start()
end

-- Detach previous execution.
if shared.TangHub then
	pcall(shared.TangHub.detach)
end
shared.TangHub = TangHub

xpcall(initializeScript, onInitializeError)
