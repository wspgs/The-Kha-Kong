---Build a string that changes whenever the round makes progress.
---@return string
function TangHub.progressSignature()
	local done, locked = 0, 0

	for name, value in pairs(workspace:GetAttributes()) do
		if value and string.sub(name, 1, 6) == "Quest_" then
			done = done + 1
		elseif value == true and string.sub(name, 1, 11) == "RoomLocked_" then
			locked = locked + 1
		end
	end

	local parts = {
		tostring(workspace:GetAttribute("QuestsDone")),
		tostring(workspace:GetAttribute("PowerOn")),
		tostring(workspace:GetAttribute("ExitOpen")),
		tostring(workspace:GetAttribute("LeverArmed")),
		tostring(localPlayer:GetAttribute("Items")),
		tostring(TangHub.countKeys()),
		tostring(done),
		tostring(locked),
	}

	for _, color in ipairs(TangHub.getKeyColors()) do
		table.insert(parts, tostring(workspace:GetAttribute(color .. "Unlocked")))
	end

	return table.concat(parts, "|")
end

---Check whether a prompt is on cooldown (the delay grows with every failed try).
---@param prompt ProximityPrompt
---@param now number
---@return boolean
function TangHub.isCoolingDown(prompt, now)
	local info = TangHub.attempts[prompt]
	if not info then
		return false
	end

	local delay = math.min(PROMPT_RETRY_DELAY * 2 ^ (info.count - 1), BACKOFF_MAX)
	return now - info.time < delay
end

---Collect usable prompts (tagged and unknown) that pass a predicate.
---@param hrp BasePart
---@param predicate function
---@return table
function TangHub.usablePrompts(hrp, predicate)
	local now = os.clock()
	local result = {}

	local function consider(prompt, key)
		if not (prompt.Enabled and prompt:IsDescendantOf(workspace)) then
			return
		end

		if TangHub.isCoolingDown(prompt, now) then
			return
		end

		if not predicate(prompt, key) then
			return
		end

		local position = getPromptPosition(prompt)
		if not position then
			return
		end

		table.insert(result, { prompt = prompt, position = position, distance = (position - hrp.Position).Magnitude })
	end

	for _, tag in pairs(TangHub.tags) do
		if tag.prompt then
			consider(tag.prompt, tag.key)
		end
	end

	for prompt in pairs(TangHub.otherPrompts) do
		consider(prompt, "other")
	end

	return result
end

---Choose the nearest prompt, preferring ones away from the ghost.
---@param list table
---@return ProximityPrompt?
function TangHub.chooseNearest(list)
	if #list == 0 then
		return nil
	end

	table.sort(list, function(a, b)
		return a.distance < b.distance
	end)

	local ghostPosition = TangHub.ghostAvoid and TangHub.getGhostPosition() or nil
	if not ghostPosition then
		return list[1].prompt
	end

	for _, entry in ipairs(list) do
		if (entry.position - ghostPosition).Magnitude > GHOST_SAFE_DISTANCE then
			TangHub.unsafeSince = nil
			return entry.prompt
		end
	end

	-- Every target is near the ghost, wait a while and then go anyway.
	TangHub.unsafeSince = TangHub.unsafeSince or os.clock()
	if os.clock() - TangHub.unsafeSince > GHOST_WAIT_LIMIT then
		TangHub.unsafeSince = nil
		return list[1].prompt
	end

	return nil
end

---Find a single prompt by ESP category key.
---@param key string
---@param pathHint string?
---@return ProximityPrompt?
function TangHub.findPrompt(key, pathHint)
	local now = os.clock()
	local fallback = nil

	for _, tag in pairs(TangHub.tags) do
		local prompt = tag.prompt
		if prompt and tag.key == key and prompt.Enabled and prompt:IsDescendantOf(workspace) then
			if TangHub.isCoolingDown(prompt, now) then
				continue
			end

			if pathHint and prompt:GetFullName():find(pathHint, 1, true) then
				return prompt
			end
			fallback = fallback or prompt
		end
	end

	return fallback
end

---Read the active quests the same way the HUD does.
---@return table
function TangHub.questState()
	local state = { items = {}, lockedRooms = {}, missingKey = false, pending = 0, quests = {} }
	local data = TangHub.questData
	if not data or typeof(data.quest) ~= "function" then
		return state
	end

	-- Items the player is carrying right now.
	local carried = {}
	for name in string.gmatch(localPlayer:GetAttribute("Items") or "", "[^,]+") do
		carried[string.lower(name)] = true
	end

	for id in string.gmatch(workspace:GetAttribute("Quests") or "", "[^,]+") do
		local success, quest = pcall(data.quest, id)
		if not (success and quest) or workspace:GetAttribute("Quest_" .. tostring(quest.id)) then
			continue
		end

		state.pending = state.pending + 1
		table.insert(state.quests, quest)

		-- Locked room: unlock it if we have the key, otherwise go find one.
		local room = data.ROOMS and data.ROOMS[quest.room]
		if room and workspace:GetAttribute("RoomLocked_" .. tostring(quest.room)) ~= false then
			if hasKey(room.key) then
				state.lockedRooms[quest.room] = true
			else
				state.missingKey = true
			end
		end

		-- Item the quest needs that we do not hold yet.
		if quest.item and not carried[string.lower(tostring(quest.item))] then
			state.items[string.lower(tostring(quest.item))] = true
		end
	end

	return state
end

---Count how many padlocks remain locked (Stage 1 / Keys mode).
---@return number
function TangHub.padlocksLeft()
	local padlocksFolder = workspace:FindFirstChild("Padlocks", true)
	if padlocksFolder then
		local count = 0
		for _, child in ipairs(padlocksFolder:GetChildren()) do
			if child:IsA("Model") and string.find(string.lower(child.Name), "padlock", 1, true) then
				count = count + 1
			end
		end
		return count
	end

	if workspace:GetAttribute("ObjectiveMode") == "Keys" then
		local count = 0
		local hasAny = false
		for _, color in ipairs(TangHub.getKeyColors()) do
			local attr = workspace:GetAttribute(color .. "Unlocked")
			if attr ~= nil then
				hasAny = true
				if attr ~= true then
					count = count + 1
				end
			end
		end
		if hasAny then
			return count
		end
	end

	return 0
end

---Check whether a lock can be opened right now.
---@param prompt ProximityPrompt
---@param searchesLeft boolean
---@return boolean
local function lockReady(prompt, searchesLeft)
	local names = getAncestorNames(prompt) .. " " .. string.lower(prompt.Name)
	local colors = TangHub.getKeyColors()
	local colored = false

	for _, color in ipairs(colors) do
		if string.find(names, string.lower(color), 1, true) then
			colored = true
			if hasKey(color) and workspace:GetAttribute(color .. "Unlocked") ~= true then
				return true
			end
		end
	end

	if colored then
		return false
	end

	-- Gate lock or Loading Dock lift lock: unlock if we are holding any keys
	local held = TangHub.countKeys()
	return held > 0
end

---Pick any harmless prompt as a fallback.
---@param hrp BasePart
---@return ProximityPrompt?
function TangHub.pickAnything(hrp)
	return TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(prompt, key)
		if TASK_BLACKLIST[key] then
			return false
		end

		return not isGeneratorPrompt(prompt) or workspace:GetAttribute("PowerOn") == false
	end))
end

---Pick the next prompt in keys mode (search drawers, open the locks).
---@param hrp BasePart
---@return ProximityPrompt?
function TangHub.pickKeysTarget(hrp)
	local searches = TangHub.usablePrompts(hrp, function(_, key)
		return key == "search"
	end)

	local heldKeys = TangHub.countKeys()

	-- 1. If holding keys, unlock lift locks or padlocks immediately
	if heldKeys > 0 then
		local locks = TangHub.usablePrompts(hrp, function(prompt, key)
			return (key == "lock" or isLockPrompt(prompt)) and lockReady(prompt, #searches > 0)
		end)
		local lockTarget = TangHub.chooseNearest(locks)
		if lockTarget then
			TangHub.setStatus("ปลดล็อกทางออก")
			return lockTarget
		end

		-- In Stage 1: Padlocks are on ExitDoor, and ExitPrompt is used to unlock them!
		if TangHub.padlocksLeft() > 0 then
			local exitPrompt = TangHub.findPrompt("exit")
			if exitPrompt and exitPrompt.Enabled then
				TangHub.setStatus("ไขแม่กุญแจที่ประตูทางออก")
				return exitPrompt
			end
		end
	end

	-- 2. Pick up loose items (14 lost items, dropped keys)
	local pickups = TangHub.usablePrompts(hrp, function(_, key)
		return key == "pickup"
	end)
	local pickupTarget = TangHub.chooseNearest(pickups)
	if pickupTarget then
		TangHub.setStatus("เก็บไอเทม")
		return pickupTarget
	end

	-- 3. Search drawers for keys (5 keys)
	local searchTarget = TangHub.chooseNearest(searches)
	if searchTarget then
		TangHub.setStatus("ค้นหากุญแจในลิ้นชัก")
		return searchTarget
	end

	-- 4. Fallback if drawers are checked but padlocks remain
	if TangHub.padlocksLeft() > 0 and heldKeys > 0 then
		local exitPrompt = TangHub.findPrompt("exit")
		if exitPrompt and exitPrompt.Enabled then
			return exitPrompt
		end
	end

	return TangHub.pickAnything(hrp)
end

---Pick the next prompt in quest mode (rooms, items, quest sites).
---@param hrp BasePart
---@return ProximityPrompt?
function TangHub.pickQuestTarget(hrp)
	local state = TangHub.questState()
	local target = nil

	-- Every quest is done, the server arms the lever by itself.
	local needed = workspace:GetAttribute("QuestsNeeded")
	if state.pending == 0 and needed and (workspace:GetAttribute("QuestsDone") or 0) >= needed then
		TangHub.setStatus("เควสต์ครบ รอคันโยก")
		return nil
	end

	-- 1. If holding keys, check if there are locks (lift locks, gate locks) or doors
	if TangHub.countKeys() > 0 then
		local lock = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(prompt, key)
			return (key == "lock" or isLockPrompt(prompt)) and lockReady(prompt, true)
		end))
		if lock then
			TangHub.setStatus("ปลดล็อกทางออก")
			return lock
		end
	end

	-- Open locked rooms we already hold the key for.
	if next(state.lockedRooms) then
		target = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(prompt, key)
			if key ~= "door" then
				return false
			end

			for room in pairs(state.lockedRooms) do
				if doorMatchesRoom(prompt, room) then
					return true
				end
			end

			return false
		end))

		if target then
			TangHub.setStatus("เปิดห้องล็อก")
			return target
		end
	end

	-- Fetch the items the active quests ask for.
	if next(state.items) then
		target = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(prompt, key)
			return key == "pickup" and matchesItem(prompt, state.items)
		end))

		if target then
			TangHub.setStatus("เก็บไอเทมเควสต์")
			return target
		end
	end

	-- Pick up any loose items (e.g. lost items in Stage 2)
	local pickup = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(_, key)
		return key == "pickup"
	end))
	if pickup then
		TangHub.setStatus("เก็บไอเทม")
		return pickup
	end

	-- Quest sites (repair minigames, valves, fuse boxes), prefer the ones tied to a pending quest.
	local sites = TangHub.usablePrompts(hrp, function(prompt, key)
		if key == "turn" then
			-- If valve belongs to the valve puzzle, solveValves handles it in exact order
			if prompt:FindFirstAncestor("Valves") then
				return false
			end
			return true
		end

		if key == "quest" then
			return true
		end

		if key == "repair" then
			return not isGeneratorPrompt(prompt) or workspace:GetAttribute("PowerOn") == false
		end

		return false
	end)

	local matched = {}
	for _, entry in ipairs(sites) do
		if matchesQuest(entry.prompt, state.quests) then
			table.insert(matched, entry)
		end
	end

	target = TangHub.chooseNearest(#matched > 0 and matched or sites)
	if target then
		TangHub.setStatus("ทำเควสต์")
		return target
	end

	-- Search drawers for keys / items
	local search = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(_, key)
		return key == "search"
	end))
	if search then
		TangHub.setStatus("ค้นหาลิ้นชัก")
		return search
	end

	return TangHub.pickAnything(hrp)
end

---Universal target picker for Stage 2, Stage 3 and unknown modes.
---@param hrp BasePart
---@return ProximityPrompt?
function TangHub.pickUniversalTarget(hrp)
	local searches = TangHub.usablePrompts(hrp, function(_, key)
		return key == "search"
	end)

	-- 1. If holding keys, unlock locks (lift locks / padlocks) or doors first.
	if TangHub.countKeys() > 0 then
		local lock = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(prompt, key)
			return (key == "lock" or isLockPrompt(prompt)) and lockReady(prompt, #searches > 0)
		end))
		if lock then
			TangHub.setStatus("ปลดล็อกทางออก")
			return lock
		end

		if TangHub.padlocksLeft() > 0 then
			local exitPrompt = TangHub.findPrompt("exit")
			if exitPrompt and exitPrompt.Enabled then
				TangHub.setStatus("ไขแม่กุญแจที่ประตูทางออก")
				return exitPrompt
			end
		end

		local door = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(_, key)
			return key == "door"
		end))
		if door then
			TangHub.setStatus("เปิดประตู")
			return door
		end
	end

	-- 2. Pick up loose items or keys (lost items 0/14)
	local pickup = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(_, key)
		return key == "pickup"
	end))
	if pickup then
		TangHub.setStatus("เก็บไอเทม")
		return pickup
	end

	-- 3. Search drawers/cabinets for keys (0/5)
	local search = TangHub.chooseNearest(searches)
	if search then
		TangHub.setStatus("ค้นหากุญแจในลิ้นชัก")
		return search
	end

	-- 4. Quest / Repair / Turn sites
	local site = TangHub.chooseNearest(TangHub.usablePrompts(hrp, function(prompt, key)
		if key == "turn" then
			if prompt:FindFirstAncestor("Valves") then
				return false
			end
			return true
		end
		if key == "quest" then
			return true
		end
		if key == "repair" then
			return not isGeneratorPrompt(prompt) or workspace:GetAttribute("PowerOn") == false
		end
		return false
	end))
	if site then
		TangHub.setStatus("ทำภารกิจ")
		return site
	end

	-- 5. Fallback to anything safe
	return TangHub.pickAnything(hrp)
end

---Teleport next to a prompt and trigger it.
---@param prompt ProximityPrompt
---@param hrp BasePart
---@return boolean
function TangHub.interact(prompt, hrp)
	local position = getPromptPosition(prompt)
	if not position then
		return false
	end

	prompt.RequiresLineOfSight = false

	-- Stand on the prompt and let the server see the new position before firing.
	hrp.CFrame = CFrame.new(position + Vector3.new(0, 2.5, 0))
	hrp.AssemblyLinearVelocity = Vector3.zero
	task.wait(INTERACT_SETTLE)

	if prompt.HoldDuration > 0 then
		prompt.HoldDuration = 0
	end

	local fired = pcall(fireproximityprompt, prompt, 0)
	if not fired then
		fired = pcall(fireproximityprompt, prompt)
	end
	if not fired then
		pcall(function()
			prompt:InputHoldBegin()
			task.wait()
			prompt:InputHoldEnd()
		end)
	end

	local info = TangHub.attempts[prompt]
	if info then
		info.count = info.count + 1
		info.time = os.clock()
	else
		TangHub.attempts[prompt] = { count = 1, time = os.clock() }
	end

	return true
end

---Wait for a repair minigame started by the last interaction and let the solver finish it.
---@param expectStart boolean
function TangHub.waitMinigame(expectStart)
	if not TangHub.questRemote then
		return
	end

	local waited = os.clock()
	while expectStart and not TangHub.questActive and os.clock() - waited < MINIGAME_START_WAIT do
		task.wait(0.04)
	end

	local running = os.clock()
	while TangHub.questActive and not TangHub.detached and os.clock() - running < MINIGAME_MAX do
		task.wait(0.08)
	end
end

---Interact with a prompt and handle whatever it starts.
---@param prompt ProximityPrompt
---@param hrp BasePart
function TangHub.runPrompt(prompt, hrp)
	local tag = TangHub.tags[prompt]
	local key = tag and tag.key or "other"

	if not TangHub.interact(prompt, hrp) then
		return
	end

	TangHub.waitMinigame(MINIGAME_CATEGORIES[key] == true)
end

---Find the zone that ends the round when touched.
---@return BasePart?
function TangHub.findEscapeZone()
	local zone = TangHub.escapeZone
	if zone and zone:IsDescendantOf(workspace) then
		return zone
	end

	zone = workspace:FindFirstChild("EscapeZone", true)
	if not zone then
		local escapeRoute = workspace:FindFirstChild("EscapeRoute", true)
		if escapeRoute then
			zone = escapeRoute:FindFirstChild("EscapeZone", true) or escapeRoute:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	if not zone then
		local exitDoor = workspace:FindFirstChild("ExitDoor", true) or workspace:FindFirstChild("OutfallGate", true)
		if exitDoor then
			zone = exitDoor:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	TangHub.escapeZone = zone
	return zone
end

---Open the exit and walk into the escape zone.
---@param hrp BasePart
function TangHub.escapeStep(hrp)
	local now = os.clock()

	-- Fire the exit prompt if available (e.g. lift call / door release)
	local exitPrompt = TangHub.findPrompt("exit")
	if exitPrompt and exitPrompt.Enabled and now - TangHub.exitFiredAt > EXIT_REFIRE_DELAY then
		TangHub.exitFiredAt = now
		TangHub.interact(exitPrompt, hrp)
	end

	-- Stand inside the escape zone until the game marks us as escaped.
	local zone = TangHub.findEscapeZone()
	if zone then
		hrp.CFrame = zone.CFrame + Vector3.new(0, 1.5, 0)
		hrp.AssemblyLinearVelocity = Vector3.zero

		local head = hrp.Parent and hrp.Parent:FindFirstChild("Head")
		for _, part in ipairs({ hrp, head }) do
			pcall(firetouchinterest, part, zone, 0)
			task.wait(0.04)
			pcall(firetouchinterest, part, zone, 1)
		end
	elseif exitPrompt then
		local pos = getPromptPosition(exitPrompt)
		if pos then
			hrp.CFrame = CFrame.new(pos + Vector3.new(0, 1, 4))
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

---Read the required valve sequence from the OrderBoard.
---@return table?
local function getValveOrder()
	local orderBoard = workspace:FindFirstChild("OrderBoard", true)
	if orderBoard then
		local surfaceGui = orderBoard:FindFirstChildOfClass("SurfaceGui") or orderBoard:FindFirstChildWhichIsA("SurfaceGui", true)
		local label = surfaceGui and (surfaceGui:FindFirstChild("Order") or surfaceGui:FindFirstChildOfClass("TextLabel"))
		if label and label.Text ~= "" then
			local order = {}
			for num in string.gmatch(label.Text, "%d+") do
				table.insert(order, tonumber(num))
			end
			if #order >= 2 then
				return order
			end
		end
	end

	local attr = workspace:GetAttribute("ValveOrder") or workspace:GetAttribute("Order")
	if typeof(attr) == "string" then
		local order = {}
		for num in string.gmatch(attr, "%d+") do
			table.insert(order, tonumber(num))
		end
		if #order >= 2 then
			return order
		end
	end

	return nil
end

---Solve the valve order puzzle in exact sequence.
---@param hrp BasePart
---@return boolean
function TangHub.solveValves(hrp)
	local order = getValveOrder()
	if not order or #order == 0 then
		return false
	end

	local valvesModel = workspace:FindFirstChild("Valves", true)
	if not valvesModel then
		return false
	end

	-- Check if valves have TurnPrompt enabled
	local valvePrompts = {}
	local allEnabled = true

	for _, num in ipairs(order) do
		local valve = valvesModel:FindFirstChild("Valve" .. tostring(num))
		local prompt = valve and valve:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt and prompt.Enabled then
			valvePrompts[num] = prompt
		else
			allEnabled = false
			break
		end
	end

	-- If not all prompts exist and are enabled, puzzle might already be solved
	if not allEnabled or #order == 0 then
		return false
	end

	TangHub.setStatus("หมุนวาล์ว: " .. table.concat(order, " -> "))

	-- Turn each valve in the exact required sequence
	for _, num in ipairs(order) do
		local prompt = valvePrompts[num]
		if prompt and prompt.Enabled then
			TangHub.interact(prompt, hrp)
			task.wait(0.35)
		end
	end

	return true
end

---Check if the round is complete and the escape exit is ready.
---@param hrp BasePart
---@return boolean
function TangHub.isExitReady(hrp)
	if workspace:GetAttribute("ExitOpen") then
		return true
	end

	if workspace:GetAttribute("LeverArmed") and not TangHub.findPrompt("lever") then
		return true
	end

	-- In Stage 1: If all padlocks are unlocked, exit is ready!
	local padlocksCount = TangHub.padlocksLeft()
	if padlocksCount == 0 and workspace:FindFirstChild("Padlocks", true) then
		local exitPrompt = TangHub.findPrompt("exit")
		if exitPrompt or TangHub.findEscapeZone() then
			return true
		end
	end

	-- ExitPrompt enabled and no locks remain
	local locks = TangHub.usablePrompts(hrp, function(p, k)
		return k == "lock" or isLockPrompt(p)
	end)

	local exitPrompt = TangHub.findPrompt("exit")
	if exitPrompt and exitPrompt.Enabled and #locks == 0 and padlocksCount == 0 then
		return true
	end

	-- If all locks, padlocks, pickups and searches are done, exit is ready!
	local pickups = TangHub.usablePrompts(hrp, function(_, k)
		return k == "pickup"
	end)
	local searches = TangHub.usablePrompts(hrp, function(_, k)
		return k == "search"
	end)
	local quests = TangHub.usablePrompts(hrp, function(p, k)
		return (k == "quest" or k == "repair") and not isGeneratorPrompt(p)
	end)

	if #locks == 0 and padlocksCount == 0 and #pickups == 0 and #searches == 0 and #quests == 0 and (exitPrompt or TangHub.findEscapeZone()) then
		return true
	end

	return false
end

---One step of the auto finish state machine (follows the game's objective order).
function TangHub.autoFinishStep()
	if localPlayer:GetAttribute("Escaped") then
		if not TangHub.escapedNotified then
			TangHub.escapedNotified = true
			if TangHub.window then
				TangHub.window:notify({ Title = "Tang Hub", Text = "ออกจากด่านสำเร็จ!", Duration = 5 })
			end
		end

		if TangHub.autoFarm and not TangHub.rejoining then
			TangHub.rejoining = true
			task.spawn(function()
				task.wait(2.5)
				local remotes = replicatedStorage:FindFirstChild("HorrorRemotes")
				local spectateAction = remotes and remotes:FindFirstChild("SpectateAction")
				if spectateAction then
					spectateAction:FireServer("lobby")
				end
				task.wait(4)
				TangHub.rejoining = false
			end)
		end
		return
	end
	TangHub.escapedNotified = false

	if localPlayer:GetAttribute("Defeated") or localPlayer:GetAttribute("Spectating") then
		if TangHub.autoFarm and not TangHub.rejoining then
			TangHub.rejoining = true
			task.spawn(function()
				task.wait(2)
				local remotes = replicatedStorage:FindFirstChild("HorrorRemotes")
				local spectateAction = remotes and remotes:FindFirstChild("SpectateAction")
				if spectateAction then
					spectateAction:FireServer("lobby")
				end
				task.wait(4)
				TangHub.rejoining = false
			end)
		end
		return
	end

	-- A repair minigame is running, the solver handles it.
	if TangHub.questActive then
		return
	end

	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (hrp and humanoid and humanoid.Health > 0) or hrp.Anchored then
		return
	end

	-- QuestData can fail to load early in the round, retry it.
	if not TangHub.questData and os.clock() - TangHub.lastDataLoad > DATA_RETRY_DELAY then
		TangHub.loadQuestData()
	end

	-- Any change in the round state means the last action worked, forget old failures.
	local signature = TangHub.progressSignature()
	if signature ~= TangHub.lastSignature then
		TangHub.lastSignature = signature
		TangHub.lastProgress = os.clock()
		TangHub.lockTries = 0
		table.clear(TangHub.attempts)
	end

	-- Nothing changed for a long time, retry everything including drawers.
	if os.clock() - TangHub.lastProgress > STUCK_RESET then
		TangHub.lastProgress = os.clock()
		TangHub.lockTries = 0
		table.clear(TangHub.attempts)
		table.clear(TangHub.searched)
	end

	local mode = workspace:GetAttribute("ObjectiveMode")
	local hasQuests = (workspace:GetAttribute("Quests") or "") ~= ""
	local target = nil

	-- 1. Blackout: restart the generator first.
	if workspace:GetAttribute("PowerOn") == false then
		target = TangHub.findPrompt("repair", "GeneratorRoom")
		if target then
			TangHub.setStatus("เปิดเครื่องปั่นไฟ")
			return TangHub.runPrompt(target, hrp)
		end
	end

	-- 2. Valve Puzzle (Stage 2/3): solve valves in exact order
	if TangHub.solveValves(hrp) then
		return
	end

	-- 3. Gate / Lift is open: leave the level.
	if TangHub.isExitReady(hrp) then
		TangHub.setStatus("ออกจากด่าน")
		return TangHub.escapeStep(hrp)
	end

	-- 4. Everything is done, pull the release lever.
	if workspace:GetAttribute("LeverArmed") then
		target = TangHub.findPrompt("lever")
		if target then
			TangHub.setStatus("ดึงคันโยก")
			return TangHub.runPrompt(target, hrp)
		end

		TangHub.setStatus("เปิดประตูทางออก")
		return TangHub.escapeStep(hrp)
	end

	-- 5. Standard gameplay (Keys mode, Quest mode, or Universal mode)
	if mode == "Keys" then
		target = TangHub.pickKeysTarget(hrp)
	elseif hasQuests then
		target = TangHub.pickQuestTarget(hrp)
	else
		target = TangHub.pickUniversalTarget(hrp)
	end

	if target then
		TangHub.runPrompt(target, hrp)
	end
end

---Background loop running the auto finish.
function TangHub.autoFinishLoop()
	while not TangHub.detached do
		if TangHub.autoFinish then
			local success, failure = pcall(TangHub.autoFinishStep)
			if not success then
				warn(failure)
			end
		end

		task.wait(AUTO_STEP_DELAY)
	end
end

---Handle QuestGame events and solve the timing minigame.
---@param action string
---@param questId string
function TangHub.onQuestEvent(action, questId)
	if not (TangHub.autoFinish or TangHub.autoMinigame) then
		return
	end

	if action == "start" or action == "progress" then
		TangHub.questSession = TangHub.questSession + 1
		local session = TangHub.questSession

		TangHub.questActive = questId
		TangHub.questUpdated = os.clock()

		task.spawn(function()
			if TangHub.questRemote then
				TangHub.questRemote:FireServer("press", questId, true)
			end

			while TangHub.questSession == session and TangHub.questActive == questId and not TangHub.detached do
				if os.clock() - TangHub.questUpdated > MINIGAME_TIMEOUT then
					pcall(TangHub.questRemote.FireServer, TangHub.questRemote, "stop", questId)
					break
				end

				task.wait(MINIGAME_PRESS_DELAY)
				if TangHub.questSession ~= session or TangHub.questActive ~= questId then
					break
				end

				TangHub.questRemote:FireServer("press", questId, true)
			end

			if TangHub.questSession == session and TangHub.questActive == questId then
				TangHub.questActive = nil
			end
		end)
		return
	end

	if questId ~= TangHub.questActive then
		return
	end

	if action == "miss" then
		TangHub.questUpdated = os.clock()
		return
	end

	if action == "done" then
		TangHub.questActive = nil
	end
end

---Unload the script completely.
function TangHub.detach()
	if TangHub.detached then
		return
	end
	TangHub.detached = true

	for _, connection in ipairs(TangHub.connections) do
		connection:Disconnect()
	end

	TangHub.instantPrompt = false
	TangHub.reachMultiplier = 1
	TangHub.applyAllPrompts()
	TangHub.restoreLighting()
	TangHub.restoreNoclip()

	if TangHub.infStamina then
		localPlayer:SetAttribute("InfStamina", nil)
	end

	espFolder:Destroy()

	if TangHub.window then
		TangHub.window:destroy()
	end
end

